#!/bin/sh
# Runs millennium-code-qc, the code quality engine, for the plugin's hooks and skills.
#
# $MILLENNIUM_CODE_QC, when set, names a binary to run instead: one you built
# from source or vetted yourself. Otherwise the launcher runs the release
# named in ../code-qc.lock for this platform, downloading it on first use and
# refusing any file whose SHA-256 differs from the lock, every time it runs.
#
# The binary is kept beside the plugin (../.code-qc/<version>/), which agents'
# sandboxes can read but not write; when that is not writable, in the
# plugin's data directory. Every failure exits 2, which blocks.
set -eu

fail() {
	echo "millennium-code-qc: $*" >&2
	exit 2
}

if [ -n "${MILLENNIUM_CODE_QC:-}" ]; then
	exec "$MILLENNIUM_CODE_QC" "$@"
fi

plugin_root=$(cd "$(dirname "$0")/.." && pwd)
lock="$plugin_root/code-qc.lock"
[ -f "$lock" ] || fail "the engine lock $lock is missing; reinstall the plugin"

platform() {
	case "$(uname -s)" in
	Linux) os=linux ;;
	Darwin) os=darwin ;;
	MINGW* | MSYS* | CYGWIN*) os=windows ;;
	*) fail "unsupported operating system $(uname -s); build the engine from source and set MILLENNIUM_CODE_QC" ;;
	esac
	case "$(uname -m)" in
	x86_64 | amd64) arch=amd64 ;;
	arm64 | aarch64) arch=arm64 ;;
	*) fail "unsupported architecture $(uname -m); build the engine from source and set MILLENNIUM_CODE_QC" ;;
	esac
	echo "$os-$arch"
}
target=${MILLENNIUM_PLATFORM:-$(platform)}

version="" url="" expected=""
while read -r key first second; do
	case "$key" in
	version) version=$first ;;
	url) url=$first ;;
	sha256) if [ "$first" = "$target" ]; then expected=$second; fi ;;
	esac
done <"$lock"

if [ "$version" = "unreleased" ] || [ -z "$version" ]; then
	fail "this plugin version has no engine release yet; build one from code-qc/ (go build -o millennium-code-qc .) and set MILLENNIUM_CODE_QC to it"
fi
[ -n "$url" ] || fail "the engine lock names no download url"
[ -n "$expected" ] || fail "the engine lock has no binary for $target; build the engine from source and set MILLENNIUM_CODE_QC"

asset="millennium-code-qc-$target"
case "$target" in windows-*) asset="$asset.exe" ;; esac

sha256_of() {
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum "$1" | cut -d' ' -f1
	elif command -v shasum >/dev/null 2>&1; then
		shasum -a 256 "$1" | cut -d' ' -f1
	else
		fail "neither sha256sum nor shasum is installed, so the engine cannot be verified"
	fi
}

# A cached binary is verified on every run, so a changed file never runs.
for dir in "$plugin_root/.code-qc/$version" "${CLAUDE_PLUGIN_DATA:+$CLAUDE_PLUGIN_DATA/code-qc/$version}"; do
	if [ -n "$dir" ] && [ -f "$dir/$asset" ]; then
		[ "$(sha256_of "$dir/$asset")" = "$expected" ] || fail "$dir/$asset does not match the engine lock; delete it to download the release again"
		exec "$dir/$asset" "$@"
	fi
done

download() {
	if command -v curl >/dev/null 2>&1; then
		curl -fsSL --proto '=https,file' --max-time 300 --max-filesize 209715200 -o "$2" "$1"
	elif command -v wget >/dev/null 2>&1; then
		case "$1" in https://*) ;; *) fail "wget downloads https only: $1" ;; esac
		wget -q --timeout=300 -O "$2" "$1"
	else
		fail "neither curl nor wget is installed, so the engine cannot be downloaded"
	fi
}

dir="$plugin_root/.code-qc/$version"
if ! mkdir -p "$dir" 2>/dev/null || [ ! -w "$dir" ]; then
	[ -n "${CLAUDE_PLUGIN_DATA:-}" ] || fail "cannot write $dir to store the engine"
	dir="$CLAUDE_PLUGIN_DATA/code-qc/$version"
	mkdir -p "$dir" || fail "cannot write $dir to store the engine"
fi
partial="$dir/$asset.download.$$"
trap 'rm -f "$partial"' EXIT
download "$url/$asset" "$partial" || fail "downloading $url/$asset failed"
actual=$(sha256_of "$partial")
[ "$actual" = "$expected" ] || fail "the downloaded engine's SHA-256 is $actual, but the engine lock says $expected; refusing to run it"
chmod +x "$partial"
mv -f "$partial" "$dir/$asset"
trap - EXIT
exec "$dir/$asset" "$@"
